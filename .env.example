# Copy this file to .env and paste your Mapbox public token (starts with pk.)
# Get one at: https://account.mapbox.com -> Tokens -> Default public token
VITE_MAPBOX_TOKEN=pk.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: OpenSky API client for live aircraft (~4000 credits/day).
# Register at https://opensky-network.org -> Account -> create an API client.
# If left empty, the app falls back to the keyless adsb.lol feed.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Optional: AISStream key for live ships (free). Register at https://aisstream.io
# Note: this one is used in the browser (VITE_ prefix), so it's visible client-side.
VITE_AISSTREAM_KEY=
